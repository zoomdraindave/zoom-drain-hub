PORT=3000
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
YOUR_PHONE_NUMBER=
ANGI_API_KEY=

# ── Asset QR System ───────────────────────────────────────────────────────────
# Comma-separated list of E.164 phone numbers authorized to register assets.
# e.g. ASSET_AUTHORIZED_PHONES=+16025550100,+16025550101
ASSET_AUTHORIZED_PHONES=

# ── Service Titan API ─────────────────────────────────────────────────────────
# Steps to obtain these credentials:
#   1. Create an app at developer.servicetitan.io (select required API scopes)
#   2. Add your Tenant ID to the app's Tenant(s) section
#   3. Wait for ServiceTitan approval (~3-7 days)
#   4. In your ST tenant: Settings → Integrations → API Application Access → Connect
#   5. Generate Client ID + Client Secret in the Application Details section
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=

# ── Service Titan Scheduling Pro widget ───────────────────────────────────────
# Found in your ServiceTitan account under Scheduling Pro → Scheduler Details.
# Your app's domain must also be whitelisted there before the widget will load.
ST_SCHEDULING_PRO_API_KEY=
ST_SCHEDULER_ID=
